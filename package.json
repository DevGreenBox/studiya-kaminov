    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.26.0",
    "eslint-config-next": "^16.3.1",
    "lucide-react": "^0.469.0",
    "prettier": "^3.9.6",
