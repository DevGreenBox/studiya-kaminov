# ============================================================================
#  Пример переменных окружения. Скопируйте в .env.local и заполните.
#  В репозитории не должно быть ни одного реального секрета.
# ============================================================================

# --- Общее -----------------------------------------------------------------
# Базовый URL сайта. Используется для canonical, OpenGraph и sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Доставка ---------------------------------------------------------------
# Покупатель выбирает перевозчика при оформлении заказа: СДЭК (основной)
# или «Деловые Линии» (дополнительный, выгоднее на крупногабаритных моделях).
#
# Пока ключей нет, обе компании считаются демонстрационным провайдером
# (src/lib/delivery/mock-provider.ts). Чтобы принудительно оставить демо-режим
# даже при заполненных ключах, поставьте DELIVERY_PROVIDER=mock.
DELIVERY_PROVIDER=mock

# Город отправления (склад производства). Подставьте реальный.
DELIVERY_ORIGIN_CITY=

# СДЭК — https://api-docs.cdek.ru
CDEK_API_URL=https://api.cdek.ru
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=

# Деловые Линии — https://dev.dellin.ru
DELLIN_API_URL=https://api.dellin.ru
DELLIN_APP_KEY=
DELLIN_SESSION_ID=

# --- Уведомления на почту ---------------------------------------------------
# console — письма печатаются в терминал (режим разработки).
# smtp    — реальная отправка через SMTP.
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя и адрес магазина, куда приходят заказы и заявки.
EMAIL_FROM=
EMAIL_SHOP=
